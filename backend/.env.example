# Required for docker compose
DB_PASSWORD=change_this_to_a_strong_password
ADMIN_PASSWORD=change_this_admin_password
ADMIN_USER=admin
PORT=8080

# docker-compose.saas.yml (SIRIAUTOPOST.Api + Angular dashboard). DB_PASSWORD and
# ADMIN_PASSWORD above are reused. The compose file maps JWT_KEY/ADMIN_EMAIL/ADMIN_PASSWORD to the API's own names
# (Jwt__Key, Admin__Email, Admin__Password) and requires all three; the Section__Key lines further down (Google__,
# Stripe__) are the API's own names and pass through unchanged. Outside Docker, `dotnet run` reads this file too
# (current folder, then parents), so use the API's own names there. In Kubernetes (deploy/README.md) the env file
# uses the API's own names only.
JWT_KEY=change_this_to_a_random_string_of_at_least_32_chars
ADMIN_EMAIL=admin@example.com
WEB_PORT=8090
# Public domain for --profile https (Caddy, automatic Let's Encrypt certificate)
# DOMAIN=autopost.example.com
# UI_PATH=../siri_autopost_ui

# --- Google OAuth (Optional) ---
Google__ClientId=

# --- Stripe (payments) ---
# Paid plans are bought through Stripe Checkout; the card and invoices live in Stripe's billing portal.
# Without a secret key the dashboard shows that online payment is off and paid plans cannot be bought.
#   1. Stripe dashboard > Developers > API keys: the secret key (sk_test_... first, sk_live_... in production).
#   2. Developers > Webhooks > add an endpoint  <public address>/api/webhooks/stripe  with the events
#      checkout.session.completed, customer.subscription.created, customer.subscription.updated,
#      customer.subscription.deleted, invoice.paid, invoice.payment_failed, refund.created, refund.updated,
#      payment_intent.succeeded, payment_intent.payment_failed, payment_intent.processing, payment_intent.canceled
#      and copy its signing secret (whsec_...). Local testing: stripe listen --forward-to localhost:5100/api/webhooks/stripe
#   3. Billing > Customer portal: switch the portal on (cards, invoices; plan changes are made in the dashboard).
Stripe__SecretKey=
# pk_test_... / pk_live_... of the same account: starts Stripe.js for the in-app payment window (card, Apple Pay, Google Pay,
# Link, PromptPay). Empty = customers are sent to Stripe's hosted Checkout page instead.
Stripe__PublishableKey=
Stripe__WebhookSecret=
# Address Stripe sends customers back to. Leave empty when the dashboard and the API share one site (nginx, Caddy).
Stripe__ReturnBaseUrl=
# Stripe__Currency=thb
# Payment method types of a subscription paid in the in-app window (card covers Apple Pay and Google Pay). Take link out if
# the account cannot use Link; empty = whatever the Stripe Dashboard has switched on.
# Stripe__SubscriptionPaymentMethods=card,link
# Stripe__PortalConfigurationId=

# --- Cloudflare R2 (Object Storage for Imported Media / Assets) ---
# Cloudflare Dashboard > R2 Object Storage:
# - Endpoint: https://<account_id>.r2.cloudflarestorage.com
# - BucketName: <bucket_name> (e.g. siriautopost-media)
# - PublicBaseUrl: Public development/custom domain (e.g. https://pub-<id>.r2.dev or https://media.siristudiophoto.com)
# - AccessKeyId & SecretAccessKey: Created from R2 > Manage R2 API Tokens (Object Read & Write)
R2__Endpoint=
R2__BucketName=
R2__PublicBaseUrl=
R2__AccessKeyId=
R2__SecretAccessKey=

# --- AI post drafts (optional) ---
# The platform's Anthropic API key. Customers on Pro and above can then ask the editor's AI panel for post drafts; with no
# key the AI buttons stay disabled and say so. The key never reaches the browser.
Ai__ApiKey=
# Ai__Model=claude-sonnet-5-5
# Drafts one workspace may ask for per day (0 = no limit).
# Ai__DailyLimit=50

# Jenkins credential `siriautopost-dev-env-file` (Secret file) -> secret api-env in namespace siriautopost-dev.
ConnectionStrings__Default=Host=<db-host>;Database=SIRIAUTOPOST;Username=<user>;Password=<password>;Gss Encryption Mode=Disable
Jwt__Key=<32+ random characters, different from prd>
Admin__Email=<dev admin email>
Admin__Password=<dev password>
Google__ClientId=
# Stripe TEST keys only (sk_test_..., a test webhook endpoint on https://siriautopost-dev.siristudiophoto.com/api/webhooks/stripe)
Stripe__SecretKey=
Stripe__WebhookSecret=
# Only for deploy/k8s/postgres/overlays/dev (in-cluster Postgres):
POSTGRES_USER=
POSTGRES_PASSWORD=

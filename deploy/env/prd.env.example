# Jenkins credential `siriautopost-env-file` (Secret file) -> secret api-env in namespace siriautopost. NEVER reuse values from dev.
ConnectionStrings__Default=Host=<db-host>;Database=SIRIAUTOPOST_PRD;Username=<user>;Password=<password>;Gss Encryption Mode=Disable
Jwt__Key=<32+ random characters, different from dev>
Admin__Email=<platform admin email>
Admin__Password=<strong password>
Google__ClientId=
Stripe__SecretKey=sk_live_...
Stripe__WebhookSecret=whsec_...
# Only for deploy/k8s/postgres/overlays/prd (in-cluster Postgres):
POSTGRES_USER=
POSTGRES_PASSWORD=
